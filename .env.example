# Copy to .env at the repo root (gitignored) and fill in. Values, not
# placeholders -- nothing here is read unless it has one. Names only in this
# file, ever: it IS tracked, and a real key committed once is a real key
# forever.

# ── the harvest ─────────────────────────────────────────────────────────────
# Mapillary client token. MLY_KEY_0, MLY_KEY_1 ... are read as a pool when the
# collector wants to rotate; MLY_KEY alone is enough to start.
MLY_KEY=<MP_API_KEY>

# ── the dashboard login ─────────────────────────────────────────────────────
# tools/dashboard/dashboard.py serves nothing at all until one of the two
# credential variables below is set: no page, no image, no /api answer, just
# the login form and a sentence saying which variable is missing. It does not
# refuse to start -- the server re-execs itself whenever a source file
# changes, with nobody watching, and a dashboard that is down is not more
# secure than a dashboard that is asking for a password.
#
# The first admin comes from here. Everybody else signs up through an invite
# link that an admin issues at /admin; there is no open registration, and the
# .env admin is a row in data/dashboard/accounts.db like every other account
# once it exists, so there is exactly one place a credential is checked.

# Who the .env admin is. Optional -- "admin" when unset. Renaming it creates
# the new account and leaves the old one alone.
DASHBOARD_USER=<username>

# The .env admin's password, in the clear. 12 characters minimum. Changing it
# re-hashes the stored one on the next start AND ends every live session for
# that account, which is the whole reason to change it.
DASHBOARD_PASSWORD=<password>

# ...or the hash of it instead, which is the better one on a shared box: this
# file is read by every tool in the repo and backed up with it, and a hash
# that leaks is an offline attack against scrypt rather than a login. Set one
# or the other; the hash wins if both are here.
#   python tools/dashboard/dashboard.py passwd
# prints exactly this line and writes nothing.
DASHBOARD_PASSWORD_HASH=<scrypt$...>

# The key every session cookie is signed with. Optional: 32 random bytes are
# written to data/dashboard/session.key on the first request when it is
# unset, which survives a restart and a re-exec. Set it (16 characters
# minimum) if you want sessions to survive a restore from backup, or a way to
# end every session on the machine at once by changing one variable.
DASHBOARD_SECRET=<random string, 16+ characters>

# How long a session lasts before it has to be signed in again. Optional,
# hours, default 168 (a week). The client that matters is a phone in a field
# and a login screen in the middle of a review queue is how a queue stops
# being reviewed; any session can be ended in one command whatever this says
# (accounts.py --sign-out USER).
DASHBOARD_SESSION_HOURS=<hours, 0.08-2160>

# How long a fresh invite link stays redeemable. Optional, hours, default 48.
# An invite is single-use whatever this says.
DASHBOARD_INVITE_TTL_HOURS=<hours, 0.08-720>
